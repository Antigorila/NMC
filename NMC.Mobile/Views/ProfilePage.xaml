<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Mobile.ViewModel"
             x:Class="NMC.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="#121212"
             Title="ProfilePage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                <ImageButton Grid.Column="0" Source="back.png" WidthRequest="24" HeightRequest="24" BackgroundColor="Transparent" Clicked="BackButton_Clicked" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="User Profile" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" Margin="16,0,0,0" VerticalOptions="Center" />
            </Grid>

            <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 20" Padding="20">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                    <Border WidthRequest="90" HeightRequest="90" StrokeThickness="1" Stroke="#444444" BackgroundColor="#2A2A2A" StrokeShape="RoundRectangle 45" HorizontalOptions="Center">
                        <Image Source="profile.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Text="{Binding Username}" FontSize="18" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" TextColor="#4CAF50" FontSize="13" HorizontalOptions="Center" IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotNullOrEmptyBoolConverter}}" />
            <Label Text="{Binding ErrorMessage}" TextColor="#FF5252" FontSize="13" HorizontalOptions="Center" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyBoolConverter}}" />
            
            <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Change Username" FontSize="14" FontAttributes="Bold" TextColor="#AAAAAA" />
                    <Entry Text="{Binding NewUsername}" Placeholder="New username" PlaceholderColor="#666666" TextColor="#FFFFFF" BackgroundColor="#2A2A2A" HeightRequest="44" />
                    <Button Text="Update Username" Command="{Binding UpdateUsernameCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="#333333" TextColor="#FFFFFF" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Change Password" FontSize="14" FontAttributes="Bold" TextColor="#AAAAAA" />
                    <Entry Text="{Binding NewPassword}" Placeholder="New password" IsPassword="True" PlaceholderColor="#666666" TextColor="#FFFFFF" BackgroundColor="#2A2A2A" HeightRequest="44" />
                    <Button Text="Update Password" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="#333333" TextColor="#FFFFFF" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                <Button Text="Log Out" Command="{Binding LogoutCommand}" BackgroundColor="#2A2A2A" TextColor="#FFFFFF" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                <Button Text="Delete Account" Command="{Binding DeleteAccountCommand}" BackgroundColor="#3D1C1C" TextColor="#FF6B6B" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>