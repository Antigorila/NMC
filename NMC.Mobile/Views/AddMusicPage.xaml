<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Mobile.ViewModel"
             x:Class="NMC.Mobile.Views.AddMusicPage"
             Title="Add Music">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center" HorizontalOptions="Center">

            <Border Stroke="Black" StrokeThickness="2" WidthRequest="200" HeightRequest="200" HorizontalOptions="Center">
                <Grid>
                    <ImageButton x:Name="TrackCover" IsEnabled="False" Source="music_placeholder.png" Aspect="AspectFill" IsVisible="True" Clicked="TrackCover_Clicked"/>
                </Grid>
            </Border>
            <Label x:Name="CoverImageLabel" IsVisible="False" Text="Tap to choose cover image" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />

            <Button x:Name="SelectTrackButton" Text="Select Track" BackgroundColor="#333333" TextColor="White" Clicked="SelectTrackButton_Clicked" IsVisible="True" WidthRequest="180" HorizontalOptions="Center"/>

            <VerticalStackLayout Spacing="15" WidthRequest="250" HorizontalOptions="Center">
                <Entry x:Name="Title" Placeholder="Title" IsVisible="False"/>
                <Entry x:Name="Artist" Placeholder="Artist" IsVisible="False"/>
                <Button x:Name="AddTrackButton" Text="Add Track" BackgroundColor="#333333" TextColor="White" Clicked="AddTrackButton_Clicked" IsVisible="False" HorizontalOptions="Center" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>