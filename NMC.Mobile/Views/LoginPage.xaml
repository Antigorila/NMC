<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Mobile.ViewModel"
             x:Class="NMC.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login"
             BackgroundColor="#121212">

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsCheckingSession}" IsVisible="{Binding IsCheckingSession}" HorizontalOptions="Center" VerticalOptions="Center" Color="White"/>
        <ScrollView IsVisible="{Binding !IsCheckingSession}">
            <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
                <Entry Placeholder="Username" Text="{Binding Username}" />
                <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" />

                <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="14" HorizontalOptions="Center" />

                <Button Text="Login" Command="{Binding LoginCommand}" BackgroundColor="#333333" TextColor="White" />
                <Button Text="Register" Command="{Binding GoToRegisterCommand}" BackgroundColor="Transparent" TextColor="Gray" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>