<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Mobile.ViewModel"
             x:Class="NMC.Mobile.Views.CreatePlaylistPage"
             Title="Create Playlist">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center" HorizontalOptions="Center">
            <Border Stroke="Black" StrokeThickness="2" WidthRequest="200" HeightRequest="200" HorizontalOptions="Center">
                <Grid>
                    <ImageButton Source="{Binding CoverPath, TargetNullValue='playlist.png'}" Aspect="AspectFill" Command="{Binding SelectCoverCommand}" />
                </Grid>
            </Border>

            <Label Text="Tap to choose cover image" HorizontalOptions="Center" TextColor="Gray" FontSize="12" />

            <VerticalStackLayout Spacing="15" WidthRequest="250" HorizontalOptions="Center">
                <Entry Placeholder="Playlist Name" Text="{Binding PlaylistName}" ClearButtonVisibility="WhileEditing" />
                <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="14" HorizontalOptions="Center" />

                <Button Text="Create Playlist" BackgroundColor="#333333" TextColor="White" Command="{Binding CreatePlaylistCommand}" IsEnabled="{Binding !IsBusy}" HorizontalOptions="Center" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>