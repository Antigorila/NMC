<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Mobile.ViewModel"
             xmlns:helpers="clr-namespace:NMC.Mobile.Helper"
             xmlns:models="clr-namespace:NMC.Mobile.Models"
             x:Class="NMC.Mobile.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="MainPage"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
            <Button x:Name="StatsButton" Grid.Column="0" VerticalOptions="Center" ImageSource="stat.png" WidthRequest="20" HeightRequest="20" BackgroundColor="#333333" Clicked="StatsButton_Clicked"/>
            <Button x:Name="ProfileButton" Grid.Column="2" VerticalOptions="Center" ImageSource="profile.png" WidthRequest="20" HeightRequest="20" BackgroundColor="#333333" Clicked="ProfileButton_Clicked"/>
        </Grid>

        <Border Grid.Row="1" Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 20" Padding="0">
            <Button x:Name="CreatePlaylistButton" Text="Add playlist" TextColor="#FFFFFF" BackgroundColor="Transparent" HeightRequest="44" FontAttributes="Bold" Clicked="CreatePlaylistButton_Clicked"/>
        </Border>

        <CollectionView Grid.Row="2" 
                ItemsSource="{Binding Playlists}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistModel">
                    <Border Stroke="#333333" StrokeThickness="1" BackgroundColor="#1E1E1E" StrokeShape="RoundRectangle 16" HeightRequest="100" Padding="0">
                        <Grid>
                            <!-- Háttérkép -->
                            <Image Source="{Binding CoverPath, TargetNullValue='music_placeholder.png'}" Aspect="AspectFill" Opacity="0.25" />

                            <!-- Tartalom -->
                            <Grid ColumnDefinitions="*, 100" Padding="16">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding PlaylistName}" FontSize="18" FontAttributes="Bold" TextColor="#FFFFFF" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TrackCount, StringFormat='{0} tracks'}" FontSize="13" TextColor="#AAAAAA" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <GraphicsView Grid.Column="1" Drawable="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=GraphDrawable, x:DataType=vm:MainViewModel}" HeightRequest="60" WidthRequest="80" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button x:Name="AddMusic" Grid.Row="3" ImageSource="addon.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="#333333" Clicked="AddMusic_Clicked"/>
    </Grid>
</ContentPage>