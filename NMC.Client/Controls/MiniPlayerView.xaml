<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             x:Class="NMC.Client.Controls.MiniPlayerView"
             x:DataType="vm:PlayerViewModel">

    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="8" BackgroundColor="LightGray">
        <Label Grid.Column="0" Text="{Binding NowPlayingText}" VerticalOptions="Center" LineBreakMode="TailTruncation">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenNowPlayingCommand}" />
            </Label.GestureRecognizers>
        </Label>
        <Button Grid.Column="1" Text="{Binding PlayPauseText}" Command="{Binding TogglePlayCommand}" />
        <Button Grid.Column="2" Text="Open" Command="{Binding OpenNowPlayingCommand}" />
    </Grid>

</ContentView>
