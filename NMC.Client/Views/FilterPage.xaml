<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             xmlns:models="clr-namespace:NMC.Client.Models"
             x:Class="NMC.Client.Views.FilterPage"
             x:DataType="vm:FilterViewModel"
             Title="Filter"
             ControlTemplate="{StaticResource PlayerPageTemplate}">

    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="8">
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Picker Title="Select a genre"
                    ItemsSource="{Binding Genres}"
                    ItemDisplayBinding="{Binding Name, x:DataType=models:CategoryModel}"
                    SelectedItem="{Binding SelectedGenre}" />

            <HorizontalStackLayout Spacing="8">
                <Label Text="Hard filter" VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsHardFilter}" />
            </HorizontalStackLayout>
            <Label Text="{Binding ModeDescription}" FontSize="12" />

            <Label Text="{Binding Threshold, StringFormat='Threshold: {0:P0}'}" IsVisible="{Binding IsSoftFilter}" />
            <Slider Minimum="0" Maximum="1" Value="{Binding Threshold}" IsVisible="{Binding IsSoftFilter}" />

            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Text="Apply filter" Command="{Binding ApplyFilterCommand}" Margin="2" />
                <Button Text="Save as playlist" Command="{Binding SaveAsPlaylistCommand}" Margin="2" />
            </FlexLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Results}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedResult}">
            <CollectionView.EmptyView>
                <Label Text="No results yet." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TrackModel">
                    <Border Margin="0,4" Padding="6" Stroke="Gray">
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <Label Text="{Binding Artist}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
