<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             x:Class="NMC.Client.Views.NowPlayingPage"
             x:DataType="vm:PlayerViewModel"
             Title="Now playing">

    <VerticalStackLayout Padding="20" Spacing="12" VerticalOptions="Center">
        <Image Source="{Binding CoverSource}" HeightRequest="220" WidthRequest="220" Aspect="AspectFill" HorizontalOptions="Center" />
        <Label Text="{Binding NowPlayingText}" FontSize="20" HorizontalOptions="Center" />

        <Slider Minimum="0" Maximum="1" Value="0" IsEnabled="False" />

        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <Button Text="Previous" Command="{Binding PreviousCommand}" />
            <Button Text="{Binding PlayPauseText}" Command="{Binding TogglePlayCommand}" />
            <Button Text="Next" Command="{Binding NextCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>

</ContentPage>
