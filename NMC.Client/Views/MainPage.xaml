<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             xmlns:models="clr-namespace:NMC.Client.Models"
             x:Class="NMC.Client.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="NMC"
             ControlTemplate="{StaticResource PlayerPageTemplate}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="10" RowSpacing="8">
        <Label Grid.Row="0" Text="{Binding Username, StringFormat='Logged in as: {0}'}" />

        <FlexLayout Grid.Row="1" Wrap="Wrap" JustifyContent="Start">
            <Button Text="Library" Command="{Binding OpenLibraryCommand}" Margin="2" />
            <Button Text="Add track" Command="{Binding OpenAddTrackCommand}" Margin="2" />
            <Button Text="New playlist" Command="{Binding CreatePlaylistCommand}" Margin="2" />
            <Button Text="Filter" Command="{Binding OpenFilterCommand}" Margin="2" />
            <Button Text="Recommendations" Command="{Binding OpenRecommendationCommand}" Margin="2" />
            <Button Text="Profile" Command="{Binding OpenProfileCommand}" Margin="2" />
        </FlexLayout>

        <Label Grid.Row="2" Text="Playlists" FontSize="18" FontAttributes="Bold" />
        <Label Grid.Row="3" Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Playlists}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedPlaylist}">
            <CollectionView.EmptyView>
                <Label Text="No playlists yet." />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistModel">
                    <Border Margin="0,4" Padding="6" Stroke="Gray">
                        <Grid ColumnDefinitions="60,*" ColumnSpacing="10">
                            <Image Grid.Column="0" Source="{Binding CoverSource}" HeightRequest="60" WidthRequest="60" Aspect="AspectFill" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding TrackCount, StringFormat='{0} tracks'}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Start" />
    </Grid>

</ContentPage>
