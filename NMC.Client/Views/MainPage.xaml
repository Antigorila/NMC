<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             xmlns:models="clr-namespace:NMC.Client.Models"
             x:Class="NMC.Client.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="NMC"
             Shell.NavBarIsVisible="False"
             ControlTemplate="{StaticResource PlayerPageTemplate}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="0">
                <Label Text="Welcome back" Style="{StaticResource Secondary}" />
                <Label Text="{Binding Username}" Style="{StaticResource PageTitle}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Profile" ImageSource="person.png" Command="{Binding OpenProfileCommand}" Style="{StaticResource ChipButton}" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <Button Grid.Row="0" Grid.Column="0" Text="Library" ImageSource="library.png" Command="{Binding OpenLibraryCommand}" Style="{StaticResource TileButton}" />
            <Button Grid.Row="0" Grid.Column="1" Text="Add track" ImageSource="upload.png" Command="{Binding OpenAddTrackCommand}" Style="{StaticResource TileButton}" />
            <Button Grid.Row="1" Grid.Column="0" Text="Filter" ImageSource="filter.png" Command="{Binding OpenFilterCommand}" Style="{StaticResource TileButton}" />
            <Button Grid.Row="1" Grid.Column="1" Text="Recommendations" ImageSource="recommend.png" Command="{Binding OpenRecommendationCommand}" Style="{StaticResource TileButton}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <Label Grid.Column="0" Text="Your playlists" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="New" ImageSource="add.png" Command="{Binding CreatePlaylistCommand}" Style="{StaticResource ChipButton}" />
        </Grid>

        <Label Grid.Row="3" Text="{Binding ErrorMessage}" Style="{StaticResource Error}" IsVisible="{Binding HasError}" />

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Playlists}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedPlaylist}">
            <CollectionView.EmptyView>
                <Label Text="No playlists yet. Create one with + New." Style="{StaticResource Secondary}" HorizontalOptions="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlaylistModel">
                    <Border Style="{StaticResource ListItem}">
                        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource CoverFrame}" HeightRequest="56" WidthRequest="56">
                                <Image Source="{Binding CoverSource}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{Binding TrackCount, StringFormat='{0} tracks'}" Style="{StaticResource Secondary}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" Source="chevron_right.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="4" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Start" />
    </Grid>

</ContentPage>
