<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             x:Class="NMC.Client.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register">

    <VerticalStackLayout Padding="20" Spacing="10" VerticalOptions="Center">
        <Label Text="NMC - Register" FontSize="28" HorizontalOptions="Center" />

        <Entry Placeholder="Username" Text="{Binding Username}" />
        <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" />
        <Entry Placeholder="Confirm password" Text="{Binding ConfirmPassword}" IsPassword="True" />

        <Button Text="Register" Command="{Binding RegisterCommand}" />
        <Button Text="Back to login" Command="{Binding GoBackCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />
    </VerticalStackLayout>

</ContentPage>
