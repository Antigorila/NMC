<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             xmlns:controls="clr-namespace:NMC.Client.Controls"
             x:Class="NMC.Client.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Register">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0" Title="Register" BackCommand="{Binding GoBackCommand}" />

        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="*,Auto,*" Padding="24" MinimumHeightRequest="600">
                <VerticalStackLayout Grid.Row="1" Spacing="12" MaximumWidthRequest="420">
                    <Label Text="NMC" FontSize="48" FontFamily="OpenSansSemibold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    <Label Text="Create your account" Style="{StaticResource Secondary}" HorizontalOptions="Center" />

                    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Register" Style="{StaticResource SectionTitle}" />
                            <Entry Placeholder="Username" Text="{Binding Username}" />
                            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" />
                            <Entry Placeholder="Confirm password" Text="{Binding ConfirmPassword}" IsPassword="True" />
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" IsVisible="{Binding HasError}" />
                            <Button Text="Register" Command="{Binding RegisterCommand}" Style="{StaticResource PrimaryButton}" />
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="I already have an account" Command="{Binding GoBackCommand}" Style="{StaticResource LinkButton}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
