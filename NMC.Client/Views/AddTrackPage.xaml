<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             x:Class="NMC.Client.Views.AddTrackPage"
             x:DataType="vm:AddTrackViewModel"
             Title="Add track"
             ControlTemplate="{StaticResource PlayerPageTemplate}">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="8">
            <Button Text="Pick audio file" Command="{Binding PickAudioFileCommand}" HorizontalOptions="Start" />
            <Label Text="{Binding FilePath, StringFormat='File: {0}'}" IsVisible="{Binding HasFile}" FontSize="12" />

            <Image Source="{Binding CoverSource}" HeightRequest="120" WidthRequest="120" Aspect="AspectFill" HorizontalOptions="Start" />
            <Button Text="Pick cover" Command="{Binding PickCoverCommand}" HorizontalOptions="Start" />

            <Entry Placeholder="Title" Text="{Binding Title}" />
            <Entry Placeholder="Artist" Text="{Binding Artist}" />
            <Label Text="Title and artist are required." FontSize="12" />

            <Button Text="Upload and analyse" Command="{Binding UploadCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding HasError}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
