<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             xmlns:controls="clr-namespace:NMC.Client.Controls"
             xmlns:models="clr-namespace:NMC.Client.Models"
             x:Class="NMC.Client.Views.SelectTracksPage"
             x:DataType="vm:SelectTracksViewModel"
             Title="Add tracks"
             ControlTemplate="{StaticResource PlayerPageTemplate}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0" Title="{Binding PageTitle}" BackCommand="{Binding GoBackCommand}" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Padding="16,8,16,12" RowSpacing="10">
            <Label Grid.Row="0" Text="Tap the tracks you want to add." Style="{StaticResource Secondary}" />
            <Label Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource Error}" IsVisible="{Binding HasError}" />

            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding AvailableTracks}"
                            SelectionMode="Multiple"
                            SelectedItems="{Binding SelectedTracks}">
                <CollectionView.EmptyView>
                    <Label Text="Every track of your library is already in this playlist." Style="{StaticResource Secondary}" HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackModel">
                        <Border Style="{StaticResource ListItem}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                                            <Setter Property="Stroke" Value="{StaticResource Outline}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDim}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                <Border Grid.Column="0" Style="{StaticResource CoverFrame}" HeightRequest="44" WidthRequest="44">
                                    <Image Source="{Binding CoverSource}" Aspect="AspectFill" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label Text="{Binding Title}" Style="{StaticResource ItemTitle}" />
                                    <Label Text="{Binding Artist}" Style="{StaticResource Secondary}" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Start" />

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="{Binding SelectionText}" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Add selected" ImageSource="add.png" Command="{Binding AddSelectedCommand}" Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
