<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.Client.ViewModels"
             xmlns:controls="clr-namespace:NMC.Client.Controls"
             xmlns:models="clr-namespace:NMC.Client.Models"
             x:Class="NMC.Client.Views.RecommendationPage"
             x:DataType="vm:RecommendationViewModel"
             Title="Recommendations"
             ControlTemplate="{StaticResource PlayerPageTemplate}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader Grid.Row="0" Title="Recommendations" BackCommand="{Binding GoBackCommand}" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="12">
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Reference playlist" Style="{StaticResource SectionTitle}" />
                    <Label Text="Tracks closest to this playlist will be recommended." Style="{StaticResource Caption}" />
                    <Picker Title="Select a playlist"
                            ItemsSource="{Binding ReferencePlaylists}"
                            ItemDisplayBinding="{Binding Name, x:DataType=models:PlaylistModel}"
                            SelectedItem="{Binding SelectedReference}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Save as playlist" Command="{Binding SaveAsPlaylistCommand}" />
                        <Button Grid.Column="1" Text="Recommend" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="1" Spacing="6">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" IsVisible="{Binding HasError}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="Recommended tracks" Style="{StaticResource SectionTitle}" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Results}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedResult}">
                <CollectionView.EmptyView>
                    <Label Text="No recommendations yet." Style="{StaticResource Secondary}" HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackModel">
                        <Border Style="{StaticResource ListItem}">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="{Binding Title}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{Binding Artist}" Style="{StaticResource Secondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>

</ContentPage>
