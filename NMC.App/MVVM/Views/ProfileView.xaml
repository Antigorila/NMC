<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NMC.App.MVVM.Views.ProfileView">

    <VerticalStackLayout Padding="20" Spacing="10" BackgroundColor="#111">
        <Label Text="Felhasználói Profil" FontSize="20" TextColor="White" FontAttributes="Bold"/>
        <Label Text="Itt lesznek a profil adatok..." TextColor="Gray"/>
        <Button Text="Vissza a Főoldalra" x:Name="BackBtn" Clicked="OnBackButtonClicked" />
    </VerticalStackLayout>

</ContentView>