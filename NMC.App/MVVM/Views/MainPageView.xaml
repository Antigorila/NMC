<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NMC.App.MVVM.ViewModels"
             x:Class="NMC.App.MVVM.Views.MainPageView"
             Title="Zene Kezelő">

    <Grid RowDefinitions="*, Auto">

        <Border Stroke="Yellow" StrokeThickness="2" Grid.Row="0">
            <ContentView Content="{Binding CurrentMainContent}" />
        </Border>

        <Border Stroke="Red" StrokeThickness="2" Grid.Row="1">
            <Frame BackgroundColor="#222222" Padding="12" HasShadow="True" CornerRadius="0">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="{Binding CurrentSongTitle}" TextColor="White" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                    <Button Grid.Column="1" Text="{Binding PlayPauseButtonText}" Command="{Binding TogglePlayCommand}" BackgroundColor="#444" TextColor="White"/>
                    <Button Grid.Column="2" Text="Open" Command="{Binding OpenFullPlayerCommand}" BackgroundColor="Transparent" TextColor="White"/>
                </Grid>
            </Frame>
        </Border>

    </Grid>
</ContentPage>