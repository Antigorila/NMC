<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NMC.App.MVVM.ViewModels"
             x:Class="NMC.App.MVVM.Views.RegisterView"
             Title="RegisterView">
    <VerticalStackLayout Spacing="10" Padding="30">
        <Entry Placeholder="Username" Text="{Binding Username}"/>
        <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True"/>
        <Button Text="Register" Command="{Binding RegisterUserCommand}"/>
        <Button Text="Back To Login" Command="{Binding GoToLoginCommand}"/>
    </VerticalStackLayout>
</ContentPage>