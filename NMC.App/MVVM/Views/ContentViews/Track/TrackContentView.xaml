<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NMC.App.MVVM.Views.ContentViews.Track.TrackContentView">

    <Grid RowDefinitions="Auto, *">

        <HorizontalStackLayout Grid.Row="0" Spacing="10" Padding="10" BackgroundColor="#222">
            <Button Text="Back" Command="{Binding GoBackToHomeCommand}" TextColor="White"/>
            <Button Text="List" Command="{Binding ShowTrackListCommand}"/>
            <Button Text="Add New" Command="{Binding ShowAddTrackCommand}"/>
        </HorizontalStackLayout>

        <Border Stroke="Orange" StrokeThickness="2" Grid.Row="1">
            <ContentView Content="{Binding CurrentTrackContent}" />
        </Border>
    </Grid>
</ContentView>
