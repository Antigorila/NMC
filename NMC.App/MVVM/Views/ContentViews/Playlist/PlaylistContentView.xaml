<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NMC.App.MVVM.Views.ContentViews.Playlist.PlaylistContentView">
    <Grid RowDefinitions="Auto, *">

        <HorizontalStackLayout Grid.Row="0" Spacing="10" Padding="10" BackgroundColor="#222">
            <Button Text="Back" Command="{Binding GoBackToHomeCommand}" TextColor="White"/>
            <Button Text="List" Command="{Binding ShowPlaylistListCommand}"/>
            <Button Text="Add New" Command="{Binding ShowPlaylistAddCommand}"/>
            <Button Text="Edit" Command="{Binding ShowPlaylistEditCommand}"/>
        </HorizontalStackLayout>

        <Border Stroke="Orange" StrokeThickness="2" Grid.Row="1">f
            <ContentView Content="{Binding CurrentPlaylistContent}" />
        </Border>
    </Grid>
</ContentView>
